---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import AdSlot from '../components/AdSlot.astro';
import PostCard from '../components/PostCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Newsletter from '../components/Newsletter.astro';
import { AFFILIATE, CATEGORIES, REVIEWER, SITE, absUrl, productId, url, webpOf } from '../lib/site';

interface Props { post: CollectionEntry<'posts'>; related: CollectionEntry<'posts'>[]; headings: { depth: number; slug: string; text: string }[] }
const { post, related, headings } = Astro.props;
const { title, seoTitle, description, pubDate, updatedDate, category, tags, heroImage, heroAlt, products } = post.data;
const toc = headings.filter((h) => h.depth === 2);
const canonical = absUrl(`/${post.id}`);
const categoryLabel = CATEGORIES[category].label;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    image: absUrl(heroImage ?? SITE.ogImage),
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: { '@type': 'Organization', name: SITE.author, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url, logo: { '@type': 'ImageObject', url: absUrl(SITE.logo) } },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': canonical,
      reviewedBy: { '@type': 'Person', name: REVIEWER.name, image: absUrl(REVIEWER.image), url: absUrl('/about') },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: categoryLabel, item: absUrl(`/category/${category}`) },
      { '@type': 'ListItem', position: 3, name: title, item: canonical },
    ],
  },
  ...(products.length > 0
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'ItemList',
          name: title,
          itemListOrder: 'https://schema.org/ItemListOrderAscending',
          numberOfItems: products.length,
          itemListElement: products.map((p, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: `${p.pick}: ${p.name}`,
            url: `${canonical}#${productId(p.name)}`,
          })),
        },
      ]
    : []),
];
---
<Base title={title} description={description} image={heroImage} type="article" publishedTime={pubDate} modifiedTime={updatedDate} jsonLd={jsonLd} contentGroup={categoryLabel} seoTitle={seoTitle}>
  <article class="mx-auto max-w-6xl px-4 pt-10">
    <nav aria-label="Breadcrumb" class="text-xs text-fg-muted">
      <a href={url('/')} class="hover:text-fg">Home</a> <span class="mx-1.5">/</span>
      <a href={url(`/category/${category}`)} class="hover:text-fg">{categoryLabel}</a>
    </nav>
    <header class="mt-4 max-w-3xl">
      <h1 class="text-3xl font-semibold tracking-tight md:text-5xl md:leading-[1.1]">{title}</h1>
      <p class="mt-4 text-lg text-fg-muted">{description}</p>
      <div class="mt-6 flex items-center gap-3 text-sm text-fg-muted">
        <img src={url(REVIEWER.image)} alt="" width="48" height="48" class="h-12 w-12 shrink-0 rounded-full border-2 border-card object-cover shadow-sm" />
        <div class="flex flex-col gap-0.5">
          <span>Reviewed by <a href={url('/about')} class="font-semibold text-fg hover:text-primary">{REVIEWER.name}</a></span>
          <span class="flex flex-wrap gap-x-3">
            <span>Published <FormattedDate date={pubDate} /></span>
            {updatedDate && <span>Updated <FormattedDate date={updatedDate} /></span>}
          </span>
        </div>
      </div>
    </header>

    {heroImage && (
      <picture class="block">
        <source srcset={url(webpOf(heroImage))} type="image/webp" />
        <img fetchpriority="high" src={url(heroImage)} alt={heroAlt ?? ''} width="1200" height="630" class="mt-8 aspect-[2/1] w-full rounded-2xl border border-line object-cover" />
      </picture>
    )}

    <p class="glass mt-8 rounded-xl px-4 py-3 text-xs text-fg-muted">{AFFILIATE.DISCLOSURE} <a href={url('/disclosure')} class="text-fg hover:text-primary">How we make money.</a></p>

    <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_300px]">
      <div class="min-w-0">
        {toc.length > 2 && (
          <nav class="glass mb-10 rounded-2xl p-5" aria-label="Table of contents">
            <h2 class="text-xs font-semibold uppercase tracking-wider text-fg-muted">In this guide</h2>
            <ol class="mt-3 grid gap-1.5 text-sm sm:grid-cols-2">
              {toc.map((h) => <li><a href={`#${h.slug}`} class="text-fg-muted hover:text-primary">{h.text}</a></li>)}
            </ol>
          </nav>
        )}

        {products.length > 0 && (
          <section class="glass mb-10 overflow-hidden rounded-2xl">
            <h2 class="border-b border-line px-5 py-3 text-xs font-semibold uppercase tracking-wider text-fg-muted">Our picks at a glance</h2>
            <ul class="divide-y divide-line">
              {products.map((p, i) => (
                <li class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1.5 px-5 py-3 text-sm">
                  <span><span class="mr-2 text-fg-muted">#{i + 1}</span><a href={`#${productId(p.name)}`} class="font-medium text-fg hover:text-primary">{p.name}</a></span>
                  <span class="ml-auto shrink-0 rounded-md bg-primary/15 px-2 py-0.5 text-xs text-primary">{p.pick}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <div class="prose-pc">
          <slot />
        </div>

        <AdSlot slot="inArticle" format="fluid" layout="in-article" class="mt-12" />

        {tags.length > 0 && (
          <ul class="mt-10 flex flex-wrap gap-2" aria-label="Tags">
            {tags.map((t) => <li><a href={url(`/tags/${t}`)} class="rounded-md border border-line bg-muted px-2.5 py-1 text-xs text-fg-muted hover:text-fg">#{t}</a></li>)}
          </ul>
        )}

        <div class="mt-12"><Newsletter /></div>
      </div>

      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-6">
          <AdSlot slot="sidebar" format="auto" />
          {related.length > 0 && (
            <section class="glass rounded-2xl p-5">
              <h2 class="text-xs font-semibold uppercase tracking-wider text-fg-muted">More in {categoryLabel}</h2>
              <ul class="mt-3 space-y-3 text-sm">
                {related.map((r) => <li><a href={url(`/${r.id}`)} class="text-fg-muted hover:text-primary">{r.data.title}</a></li>)}
              </ul>
            </section>
          )}
        </div>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="mt-20">
        <h2 class="text-2xl font-semibold tracking-tight">Keep reading</h2>
        <div class="mt-6 grid gap-6 md:grid-cols-3">
          {related.slice(0, 3).map((r) => <PostCard post={r} />)}
        </div>
      </section>
    )}
  </article>
</Base>
