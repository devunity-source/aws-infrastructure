---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="mx-auto max-w-3xl px-4 pt-24 text-center">
    <p class="text-sm text-fg-muted">404</p>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight">That page unplugged itself.</h1>
    <p class="mt-4 text-fg-muted">The link may be old, or we moved the article. Try the <a href="/search" class="text-primary">search</a> or go <a href="/" class="text-primary">home</a>.</p>
  </section>
</Base>
