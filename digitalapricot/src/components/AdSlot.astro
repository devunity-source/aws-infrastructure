---
/**
 * One AdSense unit. Renders nothing at all (no placeholder, no empty box) when ads are disabled,
 * the publisher ID is a placeholder, or this slot has no real unit ID yet.
 */
import { ADSENSE } from '../lib/site';
interface Props { slot: keyof typeof ADSENSE.SLOTS; format?: 'auto' | 'fluid' | 'rectangle'; layout?: string; class?: string; label?: boolean }
const { slot, format = 'auto', layout, class: cls = '', label = true } = Astro.props;
const slotId = ADSENSE.SLOTS[slot];
const configured = ADSENSE.ENABLED && /^ca-pub-\d{16}$/.test(ADSENSE.CLIENT) && /^\d{10}$/.test(slotId);
---
{configured ? (
  <div class={`ad-slot ${cls}`}>
    {label && <p class="px-2 pt-1 text-[10px] uppercase tracking-wider text-fg-muted/70">Advertisement</p>}
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={ADSENSE.CLIENT}
      data-ad-slot={slotId}
      data-ad-format={format}
      data-ad-layout={layout}
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
) : null}
