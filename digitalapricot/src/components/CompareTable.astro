---
import { productId } from '../lib/site';
// Side-by-side table of every pick. Columns come from the first product's `compare` keys, in order.
interface Product { name: string; pick: string; compare?: Record<string, string> }
interface Props { products: Product[]; caption?: string }
const { products, caption = 'Our picks compared' } = Astro.props;
const columns = Object.keys(products.find((p) => p.compare)?.compare ?? {});
---
{columns.length > 0 && (
  <section class="glass mb-10 overflow-hidden rounded-2xl" aria-labelledby="compare-heading">
    <h2 id="compare-heading" class="border-b border-line px-5 py-3 text-xs font-semibold uppercase tracking-wider text-fg-muted">{caption}</h2>
    <div class="overflow-x-auto" tabindex="0" role="region" aria-labelledby="compare-heading">
      <table class="w-full min-w-[640px] text-left text-sm">
        <thead class="text-xs text-fg-muted">
          <tr class="border-b border-line">
            <th scope="col" class="sticky left-0 bg-card px-4 py-2.5 font-medium">Pick</th>
            {columns.map((c) => <th scope="col" class="px-3 py-2.5 font-medium">{c}</th>)}
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {products.map((p, i) => (
            <tr>
              <th scope="row" class="sticky left-0 bg-card px-4 py-3 align-top font-normal">
                <a href={`#${productId(p.name)}`} class="font-medium text-fg hover:text-primary"><span class="mr-1.5 text-fg-muted">#{i + 1}</span>{p.name}</a>
                <span class="mt-0.5 block text-xs text-primary">{p.pick}</span>
              </th>
              {columns.map((c) => <td class="px-3 py-3 align-top text-fg-muted">{p.compare?.[c] ?? '—'}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
)}
