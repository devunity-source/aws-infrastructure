---
import { NEWSLETTER, url } from '../lib/site';
// Buttondown's embed endpoint. It sends a confirmation email (double opt-in) and shows its own
// "check your inbox" page, which opens in a new tab so the reader keeps their place in the article.
const user = NEWSLETTER.BUTTONDOWN_USERNAME.trim();
const action = user ? `https://buttondown.com/api/emails/embed-subscribe/${encodeURIComponent(user)}` : '';
---
{action && (
  <section class="glass rounded-2xl p-6 md:p-8">
    <h3 class="text-xl font-semibold tracking-tight">New guides, no spam</h3>
    <p class="mt-2 text-sm text-fg-muted">One email when we publish something worth your time. Unsubscribe in one click.</p>
    <form class="mt-4 flex flex-col gap-2 sm:flex-row" action={action} method="post" target="_blank" data-newsletter>
      <label class="sr-only" for="nl-email">Email address</label>
      <input id="nl-email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" class="flex-1 rounded-md border border-line bg-bg px-3 py-2 text-sm text-fg placeholder:text-fg-muted/60 focus:border-primary focus:outline-none" />
      <input type="hidden" name="embed" value="1" />
      <button type="submit" class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-fg hover:bg-primary/90">Subscribe</button>
    </form>
    <p class="mt-3 hidden text-sm text-fg" role="status" data-newsletter-done>Almost done: check your inbox and click the confirmation link.</p>
    <p class="mt-3 text-xs text-fg-muted">Sent with Buttondown. We only use your address for this newsletter. See our <a href={url('/privacy')} class="underline hover:text-fg">privacy policy</a>.</p>
  </section>
)}

<script>
  // After submit (the form posts in a new tab): show the confirm-your-email note and count the signup
  // in GA4. The email address itself is never sent to analytics.
  document.querySelectorAll<HTMLFormElement>('form[data-newsletter]').forEach((form) => {
    form.addEventListener('submit', () => {
      const done = form.parentElement?.querySelector<HTMLElement>('[data-newsletter-done]');
      if (done) done.classList.remove('hidden');
      const w = window as unknown as { gtag?: (...args: unknown[]) => void };
      w.gtag?.('event', 'sign_up', { method: 'buttondown', article: location.pathname });
    });
  });
</script>
