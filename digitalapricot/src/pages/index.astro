---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import AdSlot from '../components/AdSlot.astro';
import Newsletter from '../components/Newsletter.astro';
import RetroMonitor from '../components/RetroMonitor.astro';
import { CATEGORIES, NEWSLETTER, SITE, url } from '../lib/site';

// Newest change first, so updated guides surface as well as new ones.
const touched = (p: CollectionEntry<'posts'>) => (p.data.updatedDate ?? p.data.pubDate).valueOf();
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => touched(b) - touched(a));
const featured = posts.find((p) => p.data.featured) ?? posts[0];
// A short curated row instead of every guide; the category section below still links all of them.
const recent = posts.filter((p) => p.id !== featured?.id).slice(0, 6);
const byCategory = Object.entries(CATEGORIES)
  .map(([k, v]) => ({ key: k, ...v, posts: posts.filter((p) => p.data.category === k) }))
  .filter((c) => c.posts.length > 0);
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url, publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url } };
---
<Base title={SITE.name} jsonLd={jsonLd}>
  <section class="mx-auto grid max-w-6xl items-center gap-12 px-4 pt-16 md:pt-24 lg:grid-cols-[minmax(0,1fr)_380px]">
    <div>
    <p class="inline-flex items-center gap-2 rounded-md border border-line bg-card px-3 py-1 text-xs text-fg-muted">
      <span class="h-1.5 w-1.5 rounded-full bg-accent"></span> Picked by working engineers
    </p>
    <h1 class="mt-5 max-w-3xl text-4xl font-semibold tracking-tight md:text-6xl md:leading-[1.05]">
      The desk upgrades worth paying for.
    </h1>
    <p class="mt-5 max-w-xl text-lg text-fg-muted">{SITE.tagline}. Each guide is a short list of picks, with the reasons and the drawbacks. Nobody pays to be on it.</p>
    <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
      <a href="#guides" class="inline-flex items-center gap-2 rounded-md bg-primary px-5 py-2.5 text-sm font-medium text-primary-fg hover:bg-primary/90">Find your guide <span aria-hidden="true">↓</span></a>
      {featured && <a href={url(`/${featured.id}`)} class="text-sm text-fg-muted hover:text-fg">or start with {featured.data.title.replace(/^The /, 'the ')}</a>}
    </div>
    </div>
    <div class="w-full max-w-[340px] justify-self-center lg:max-w-none"><RetroMonitor /></div>
  </section>

  {featured && (
    <section class="mx-auto mt-16 max-w-6xl px-4">
      <PostCard post={featured} large />
    </section>
  )}

  <section class="mx-auto mt-16 max-w-6xl px-4">
    <div class="flex items-end justify-between">
      <h2 class="text-2xl font-semibold tracking-tight">Recently updated</h2>
      <a href={url('/rss.xml')} class="text-sm text-fg-muted hover:text-fg">RSS</a>
    </div>
    <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {/* Phones get three cards; the full list is one tap away in the category section. */}
      {recent.map((p, i) => <div class:list={['grid', i >= 3 && 'max-md:hidden']}><PostCard post={p} /></div>)}
    </div>
    <AdSlot slot="footer" class="mt-8" />
  </section>

  <section id="guides" class="mx-auto mt-20 max-w-6xl scroll-mt-24 px-4">
    <h2 class="text-2xl font-semibold tracking-tight">Every guide, by category</h2>
    <p class="mt-2 text-fg-muted">{posts.length} guides. Or <a href={url('/search')} class="text-primary hover:underline">search</a> for a product.</p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {byCategory.map((c) => (
        <section class="glass rounded-2xl p-5">
          <div class="flex items-start justify-between gap-4">
            <h3 class="font-semibold"><a href={url(`/category/${c.key}`)} class="hover:text-primary">{c.label}</a></h3>
            <span class="shrink-0 rounded-md bg-muted px-2 py-0.5 text-xs text-fg-muted">{c.posts.length} {c.posts.length === 1 ? 'guide' : 'guides'}</span>
          </div>
          <p class="mt-1 text-sm text-fg-muted">{c.blurb}</p>
          <ul class="mt-3 space-y-2 border-t border-line pt-3 text-sm">
            {c.posts.map((p) => <li><a href={url(`/${p.id}`)} class="text-fg hover:text-primary">{p.data.title}</a></li>)}
          </ul>
        </section>
      ))}
    </div>
  </section>

  {NEWSLETTER.BUTTONDOWN_USERNAME && <section class="mx-auto mt-20 max-w-3xl px-4"><Newsletter /></section>}
</Base>
