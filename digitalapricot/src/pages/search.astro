---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { CATEGORIES, url } from '../lib/site';
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf())
  .map((p) => ({
    href: url(`/${p.id}`), title: p.data.title, description: p.data.description, category: CATEGORIES[p.data.category].label, tags: p.data.tags.join(' '),
  }));
---
<Base title="Search" noindex>
  <section class="mx-auto max-w-3xl px-4 pt-14">
    <h1 class="text-4xl font-semibold tracking-tight">Search</h1>
    <label class="sr-only" for="q">Search guides</label>
    <input id="q" type="search" autofocus placeholder="Try “mouse”, “keyboard” or “ultrabook”" class="mt-6 w-full rounded-xl border border-line bg-card px-4 py-3 text-fg placeholder:text-fg-muted/60 focus:border-primary focus:outline-none" />
    <p id="count" class="mt-3 text-sm text-fg-muted" aria-live="polite"></p>
    <ul id="results" class="mt-3 space-y-3" data-posts={JSON.stringify(posts)}></ul>
  </section>
  <script>
    import { search, type SearchDoc } from '../lib/search';
    const q = document.getElementById('q') as HTMLInputElement;
    const out = document.getElementById('results') as HTMLUListElement;
    const count = document.getElementById('count') as HTMLParagraphElement;
    const posts: SearchDoc[] = JSON.parse(out.dataset.posts ?? '[]');
    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
    const run = () => {
      const term = q.value.trim();
      const list = search(posts, term);
      count.textContent = term ? `${list.length} guide${list.length === 1 ? '' : 's'} for “${term}”` : `All ${posts.length} guides`;
      out.innerHTML = list.length
        ? list.map((p) => `<li class="glass elevate rounded-2xl p-5"><span class="text-xs text-primary">${esc(p.category)}</span><a href="${esc(p.href)}" class="mt-1 block font-semibold hover:text-primary">${esc(p.title)}</a><p class="mt-1 text-sm text-fg-muted">${esc(p.description)}</p></li>`).join('')
        : '<li class="text-fg-muted">No matches. Try a product type, like “monitor” or “headphones”.</li>';
      const url = new URL(location.href);
      if (term) url.searchParams.set('q', term); else url.searchParams.delete('q');
      history.replaceState(null, '', url);
    };
    q.value = new URLSearchParams(location.search).get('q') ?? '';
    q.addEventListener('input', run);
    run();
  </script>
</Base>
