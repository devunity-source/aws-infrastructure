---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import AdSlot from '../components/AdSlot.astro';
import Newsletter from '../components/Newsletter.astro';
import { CATEGORIES, SITE } from '../lib/site';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p.id !== featured?.id);
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url, publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url } };
---
<Base title={SITE.name} jsonLd={jsonLd}>
  <section class="mx-auto max-w-6xl px-4 pt-16 md:pt-24">
    <p class="inline-flex items-center gap-2 rounded-md border border-line bg-card px-3 py-1 text-xs text-fg-muted">
      <span class="h-1.5 w-1.5 rounded-full bg-accent"></span> Tested by working engineers
    </p>
    <h1 class="mt-5 max-w-3xl text-4xl font-semibold tracking-tight md:text-6xl md:leading-[1.05]">
      Gear that earns its place on your desk.
    </h1>
    <p class="mt-5 max-w-xl text-lg text-fg-muted">{SITE.tagline}. No sponsored rankings, no 40-item lists. Just the few things we would buy again.</p>
    <div class="mt-8 flex flex-wrap gap-2">
      {Object.entries(CATEGORIES).map(([k, v]) => (
        <a href={`/category/${k}`} class="glass elevate rounded-md px-3.5 py-2 text-sm text-fg-muted hover:text-fg">{v.label}</a>
      ))}
    </div>
  </section>

  {featured && (
    <section class="mx-auto mt-16 max-w-6xl px-4">
      <PostCard post={featured} large />
    </section>
  )}

  <section class="mx-auto mt-16 max-w-6xl px-4">
    <div class="flex items-end justify-between">
      <h2 class="text-2xl font-semibold tracking-tight">Latest guides</h2>
      <a href="/rss.xml" class="text-sm text-fg-muted hover:text-fg">RSS</a>
    </div>
    <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {rest.slice(0, 3).map((p) => <PostCard post={p} />)}
    </div>
    <AdSlot slot="footer" class="mt-8" />
    <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {rest.slice(3).map((p) => <PostCard post={p} />)}
    </div>
  </section>

  <section class="mx-auto mt-20 max-w-6xl px-4">
    <h2 class="text-2xl font-semibold tracking-tight">Browse by category</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {Object.entries(CATEGORIES).map(([k, v]) => {
        const n = posts.filter((p) => p.data.category === k).length;
        return (
          <a href={`/category/${k}`} class="glass elevate flex items-start justify-between gap-4 rounded-2xl p-5">
            <div>
              <h3 class="font-semibold">{v.label}</h3>
              <p class="mt-1 text-sm text-fg-muted">{v.blurb}</p>
            </div>
            <span class="shrink-0 rounded-md bg-muted px-2 py-0.5 text-xs text-fg-muted">{n} {n === 1 ? 'guide' : 'guides'}</span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="mx-auto mt-20 max-w-3xl px-4"><Newsletter /></section>
</Base>
