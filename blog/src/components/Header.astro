---
import Logo from './Logo.astro';
import { CATEGORIES, SITE } from '../lib/site';
const path = Astro.url.pathname;
const nav = Object.entries(CATEGORIES).map(([k, v]) => ({ href: `/category/${k}`, label: v.label }));
---
<header class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-4">
    <Logo />
    <nav class="hidden items-center gap-1 md:flex" aria-label="Categories">
      {nav.map((n) => (
        <a
          href={n.href}
          class:list={[
            'rounded-md px-3 py-1.5 text-sm transition-colors',
            path.startsWith(n.href) ? 'bg-muted text-fg' : 'text-fg-muted hover:bg-muted hover:text-fg',
          ]}
        >{n.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <a href="/search" class="grid h-9 w-9 place-items-center rounded-md border border-line text-fg-muted hover:text-fg hover:bg-muted" aria-label="Search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <a href={SITE.parentUrl} class="hidden rounded-md bg-primary px-3.5 py-2 text-sm font-medium text-primary-fg hover:bg-primary/90 sm:inline-flex">Main site</a>
      <button id="nav-toggle" class="grid h-9 w-9 place-items-center rounded-md border border-line md:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="hidden border-t border-line px-4 py-3 md:hidden" aria-label="Categories">
    <div class="grid grid-cols-2 gap-1">
      {nav.map((n) => (
        <a href={n.href} class="rounded-md px-3 py-2 text-sm text-fg-muted hover:bg-muted hover:text-fg">{n.label}</a>
      ))}
      <a href="/about" class="rounded-md px-3 py-2 text-sm text-fg-muted hover:bg-muted hover:text-fg">About</a>
      <a href={SITE.parentUrl} class="rounded-md px-3 py-2 text-sm text-primary">Main site</a>
    </div>
  </nav>
</header>
<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = menu!.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
