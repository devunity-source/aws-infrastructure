---
const { class: cls = '' } = Astro.props;
---
<a href="/" class={`group inline-flex items-center gap-2.5 ${cls}`} aria-label="Protocloud Gear home">
  <span class="grid h-9 w-9 place-items-center rounded-md bg-primary/15 border border-primary/30">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 7.5 12 3l8 4.5v9L12 21l-8-4.5v-9Z" stroke="hsl(217 91% 60%)" stroke-width="1.8" stroke-linejoin="round"/>
      <path d="M12 12 20 7.5M12 12v9M12 12 4 7.5" stroke="hsl(199 89% 48%)" stroke-width="1.8" stroke-linejoin="round"/>
    </svg>
  </span>
  <span class="leading-none">
    <span class="block text-[15px] font-semibold tracking-tight">Protocloud <span class="text-primary">Gear</span></span>
    <span class="block text-[11px] text-fg-muted">by Protocloud Solutions</span>
  </span>
</a>
